NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opentexila
DB_USER=opentexila
DB_PASSWORD=replace-with-local-app-password
DB_ROOT_PASSWORD=replace-with-local-root-password
INSTITUTION_TIMEZONE=Asia/Kuala_Lumpur
# Shared Docker stack (ports on your machine; container ports stay fixed).
BACKEND_PORT=3000
FRONTEND_DEV_PORT=5173
FRONTEND_MOCK_AUTH=false
# Local seeded accounts + real APIs; never enable outside development.
DEV_AUTH_ENABLED=true
# Paths are relative to this backend checkout unless absolute.
FRONTEND_DIR=../frontend
FRONTEND_REPO_URL=https://github.com/AungMoeThuam/opentexila.git
# The Docker stack loads database/dummy-data.sql into an empty database; set
# SEED_DEMO_DATA=false to skip it. Demo accounts use password: opentexila-demo-password
# SEED_DEMO_DATA=true
# Host-side `npm run db:seed` only; do not use a real account password.
# SEED_PASSWORD=choose-a-demo-password-at-least-12-characters

# Enable real JWT auth endpoints; keep DEV_AUTH_ENABLED=false in this mode.
JWT_AUTH_ENABLED=false
# Required when JWT_AUTH_ENABLED=true.
# Generate with: openssl rand -base64 32
# JWT_SECRET=
