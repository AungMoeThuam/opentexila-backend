# Copy to .env.production on the server and fill in every value.
# Never commit .env.production.

# The public address of the demo. Its DNS A record must point at the server.
DOMAIN=opentexila.example.com
# Let's Encrypt sends certificate warnings to this address.
ACME_EMAIL=you@example.com

DB_NAME=opentexila
DB_USER=opentexila
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Password of every demo account (12 characters or more). Leave empty to use
# the one in docs/PRODUCTION_DEMO_ACCOUNTS.md.
SEED_PASSWORD=

INSTITUTION_TIMEZONE=Australia/Melbourne
# The frontend checkout, relative to this folder.
FRONTEND_DIR=../frontend
