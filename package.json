{
  "name": "opentexila-backend",
  "version": "0.0.1",
  "description": "OpenTexila classroom management API \u2014 initial JavaScript scaffold.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.1"
  },
  "scripts": {
    "build": "babel src --out-dir dist --extensions .js --delete-dir-on-start",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nodemon",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "format": "prettier --write \"src/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"*.json\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  }
}
